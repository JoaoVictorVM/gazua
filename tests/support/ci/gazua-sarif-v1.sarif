  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Gazua",
          "informationUri": "https://github.com/JoaoVictorVM/gazua",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "gazua/prompt_only_permission",
              "name": "PromptOnlyPermission",
              "shortDescription": {
                "text": "Permission enforced only by the prompt"
              },
              "helpUri": "https://github.com/JoaoVictorVM/gazua/blob/main/docs/fix-guide.md",
              "properties": {
                "tags": [
                  "security",
                  "gazua"
                ],
                "damage": "prompt_only_permission"
              }
            },
            {
              "id": "gazua/secret_in_context",
              "name": "SecretInContext",
              "shortDescription": {
                "text": "Secret reachable from the agent context"
              },
              "helpUri": "https://github.com/JoaoVictorVM/gazua/blob/main/docs/fix-guide.md",
              "properties": {
                "tags": [
                  "security",
                  "gazua"
                ],
                "damage": "secret_in_context"
              }
            },
            {
              "id": "gazua/idor_via_agent",
              "name": "IdorViaAgent",
              "shortDescription": {
                "text": "Another user's record reached through the agent"
              },
              "helpUri": "https://github.com/JoaoVictorVM/gazua/blob/main/docs/fix-guide.md",
              "properties": {
                "tags": [
                  "security",
                  "gazua"
                ],
                "damage": "idor_via_agent"
              }
            },
            {
              "id": "gazua/unhandled_output",
              "name": "UnhandledOutput",
              "shortDescription": {
                "text": "Agent output reaches a sink without handling"
              },
              "helpUri": "https://github.com/JoaoVictorVM/gazua/blob/main/docs/fix-guide.md",
              "properties": {
                "tags": [
                  "security",
                  "gazua"
                ],
                "damage": "unhandled_output"
              }
            },
            {
              "id": "gazua/unlocked_memory",
              "name": "UnlockedMemory",
              "shortDescription": {
                "text": "Persistent memory written without control"
              },
              "helpUri": "https://github.com/JoaoVictorVM/gazua/blob/main/docs/fix-guide.md",
              "properties": {
                "tags": [
                  "security",
                  "gazua"
                ],
                "damage": "unlocked_memory"
              }
            },
            {
              "id": "gazua/unchecked_spending",
              "name": "UncheckedSpending",
              "shortDescription": {
                "text": "Spending without a server-side limit"
              },
              "helpUri": "https://github.com/JoaoVictorVM/gazua/blob/main/docs/fix-guide.md",
              "properties": {
                "tags": [
                  "security",
                  "gazua"
                ],
                "damage": "unchecked_spending"
              }
            }
          ]
        }
