{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JoaoVictorVM/gazua/main/src/gazua/schemas/run-v1.schema.json",
  "$defs": {
    "AttackResult": {
      "additionalProperties": false,
      "description": "The verdict of one attack unit over all its repetitions.",
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "attack_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
          "title": "Attack Key",
          "type": "string"
        },
        "mold_id": {
          "minLength": 1,
          "title": "Mold Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "tools",
            "agent"
          ],
          "title": "Mode",
          "type": "string"
        },
        "damage": {
          "enum": [
            "prompt_only_permission",
            "secret_in_context",
            "idor_via_agent",
            "unhandled_output",
            "unlocked_memory",
            "unchecked_spending"
          ],
          "title": "Damage",
          "type": "string"
        },
        "state": {
          "enum": [
            "finding",
            "conditional_risk",
            "resisted",
            "not_tested",
            "not_applicable"
          ],
          "title": "State",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "planned": {
          "minimum": 1,
          "title": "Planned",
          "type": "integer"
        },
        "evaluated": {
          "minimum": 0,
          "title": "Evaluated",
          "type": "integer"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable_count": {
          "minimum": 0,
          "title": "Not Applicable Count",
          "type": "integer"
        },
        "state_counts": {
          "$ref": "#/$defs/StateCounts"
        },
        "rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rate"
        },
        "upper_bound": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Bound"
        },
        "confidence": {
          "maximum": 0.95,
          "minimum": 0.95,
          "title": "Confidence",
          "type": "number"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "none"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "gated": {
          "title": "Gated",
          "type": "boolean"
        },
        "low_fidelity": {
          "title": "Low Fidelity",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "operational_errors": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Operational Errors",
          "type": "array"
        },
        "proof": {
          "items": {
            "$ref": "#/$defs/Proof"
          },
          "title": "Proof",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "attack_key",
        "mold_id",
        "mode",
        "damage",
        "state",
        "severity",
        "planned",
        "evaluated",
        "successes",
        "unknown",
        "not_applicable_count",
        "state_counts",
        "rate",
        "upper_bound",
        "confidence",
        "coverage",
        "gated",
        "low_fidelity",
        "reasons",
        "operational_errors",
        "proof"
      ],
      "title": "Gazua attack result",
      "type": "object"
    },
    "ExecutionRecord": {
      "additionalProperties": false,
      "description": "How one planned execution ended. Exactly one exists per attempt and per unstarted entry.",
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^GAZUA-[A-Za-z0-9-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^GAZUA-[A-Za-z0-9-]+$",
          "title": "Execution Id",
          "type": "string"
        },
        "request_key": {
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        },
        "mold_id": {
          "minLength": 1,
          "title": "Mold Id",
          "type": "string"
        },
        "repetition": {
          "exclusiveMinimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "timed_out",
            "killed_at_ceiling",
            "skipped_by_limit",
            "crashed",
            "reset_failed",
            "rate_limited",
            "cancelled",
            "not_tested"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "started_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Ms"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "admitted_tool_calls": {
          "minimum": 0,
          "title": "Admitted Tool Calls",
          "type": "integer"
        },
        "evidence_complete": {
          "title": "Evidence Complete",
          "type": "boolean"
        },
        "truncated_tail": {
          "title": "Truncated Tail",
          "type": "boolean"
        },
        "reported_cost_usd": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Cost Usd"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Cost Usd"
        },
        "usage_complete": {
          "title": "Usage Complete",
          "type": "boolean"
        },
        "call_log": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Call Log"
        },
        "receiver_hits": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receiver Hits"
        },
        "output": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output"
        },
        "reset_before": {
          "enum": [
            "absent",
            "succeeded",
            "failed",
            "timed_out",
            "not_started"
          ],
          "title": "Reset Before",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "execution_id",
        "request_key",
        "mold_id",
        "repetition",
        "attempt",
        "status",
        "reason",
        "started_at",
        "finished_at",
        "duration_ms",
        "exit_code",
        "admitted_tool_calls",
        "evidence_complete",
        "truncated_tail",
        "reported_cost_usd",
        "estimated_cost_usd",
        "usage_complete",
        "call_log",
        "receiver_hits",
        "output",
        "reset_before"
      ],
      "title": "Gazua execution record",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "Proven scenarios of one target, mode, mold and tool, under one stable id.",
      "properties": {
        "id": {
          "pattern": "^finding-[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "tools",
            "agent"
          ],
          "title": "Mode",
          "type": "string"
        },
        "mold_id": {
          "minLength": 1,
          "title": "Mold Id",
          "type": "string"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Name"
        },
        "damage": {
          "enum": [
            "prompt_only_permission",
            "secret_in_context",
            "idor_via_agent",
            "unhandled_output",
            "unlocked_memory",
            "unchecked_spending"
          ],
          "title": "Damage",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "gated": {
          "title": "Gated",
          "type": "boolean"
        },
        "scenarios": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scenarios",
          "type": "array"
        },
        "attack": {
          "minLength": 1,
          "title": "Attack",
          "type": "string"
        },
        "proof_ids": {
          "items": {
            "pattern": "^proof-[0-9]{6,}$",
            "type": "string"
          },
          "title": "Proof Ids",
          "type": "array"
        },
        "conditions": {
          "items": {
            "enum": [
              "dry_run",
              "attempted_action_only",
              "low_fidelity",
              "raised_after_call",
              "monetary_effect_not_proven",
              "fixture_specific",
              "exfiltration_attempt_only",
              "gazua_ceiling",
              "target_limit_unknown",
              "cost_not_proven",
              "execution_incomplete",
              "truncated_tail",
              "delivered_after_injection",
              "test_sink_only",
              "synthetic_marker"
            ],
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "reproduction": {
          "$ref": "#/$defs/Reproduction"
        },
        "fix_ref": {
          "enum": [
            "prompt_only_permission",
            "secret_in_context",
            "idor_via_agent",
            "unhandled_output",
            "unlocked_memory",
            "unchecked_spending"
          ],
          "title": "Fix Ref",
          "type": "string"
        },
        "fix": {
          "minLength": 1,
          "title": "Fix",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mode",
        "mold_id",
        "tool_name",
        "damage",
        "severity",
        "gated",
        "scenarios",
        "attack",
        "proof_ids",
        "conditions",
        "reproduction",
        "fix_ref",
        "fix"
      ],
      "title": "Finding",
      "type": "object"
    },
    "JsonValue": {},
    "Limits": {
      "additionalProperties": false,
      "description": "Ceilings of a run. Durations are in seconds and costs in USD.",
      "properties": {
        "max_runs": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Max Runs",
          "type": "integer"
        },
        "timeout": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "number"
        },
        "max_tool_calls": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "concurrency": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Concurrency",
          "type": "integer"
        },
        "max_cost": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "cost_per_run": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Per Run"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Proof": {
      "additionalProperties": false,
      "description": "Where an effect was observed. It points to redacted evidence and never holds raw values.",
      "properties": {
        "signal": {
          "enum": [
            "forbidden_tool_call",
            "sensitive_tool_call",
            "canary_in_response",
            "canary_in_tool_arguments",
            "receiver_hit",
            "victim_record_access",
            "output_sink_effect",
            "memory_effect",
            "tool_call_ceiling"
          ],
          "title": "Signal",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^GAZUA-[A-Za-z0-9-]+$",
          "title": "Execution Id",
          "type": "string"
        },
        "call_seq": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Seq"
        },
        "hit_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hit Id"
        },
        "reference": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "canary_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canary Index"
        },
        "position": {
          "anyOf": [
            {
              "enum": [
                "response",
                "tool_return",
                "tool_arguments"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "conditions": {
          "items": {
            "enum": [
              "dry_run",
              "attempted_action_only",
              "low_fidelity",
              "raised_after_call",
              "monetary_effect_not_proven",
              "fixture_specific",
              "exfiltration_attempt_only",
              "gazua_ceiling",
              "target_limit_unknown",
              "cost_not_proven",
              "execution_incomplete",
              "truncated_tail",
              "delivered_after_injection",
              "test_sink_only",
              "synthetic_marker"
            ],
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Facts",
          "type": "object"
        }
      },
      "required": [
        "signal",
        "execution_id"
      ],
      "title": "Proof",
      "type": "object"
    },
    "ProofSnapshot": {
      "additionalProperties": false,
      "description": "A treated excerpt of the evidence behind one native proof.\n\n``attack_key`` and ``proof_index`` locate the proof in the verdicts. ``content`` is null\nwhen no excerpt could be kept, and ``omission_reason`` then says why.",
      "properties": {
        "id": {
          "pattern": "^proof-[0-9]{6,}$",
          "title": "Id",
          "type": "string"
        },
        "attack_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
          "title": "Attack Key",
          "type": "string"
        },
        "proof_index": {
          "minimum": 0,
          "title": "Proof Index",
          "type": "integer"
        },
        "execution_id": {
          "pattern": "^GAZUA-[A-Za-z0-9-]+$",
          "title": "Execution Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "call",
            "tool_return",
            "output",
            "receiver",
            "sink",
            "memory",
            "operational"
          ],
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "content": {
          "$ref": "#/$defs/JsonValue"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "omission_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Omission Reason"
        }
      },
      "required": [
        "id",
        "attack_key",
        "proof_index",
        "execution_id",
        "source",
        "locator",
        "content",
        "truncated",
        "omission_reason"
      ],
      "title": "ProofSnapshot",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "Why a repetition was not tested or stayed conditional, as a closed code.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "missing": {
          "items": {
            "enum": [
              "tool.forbidden",
              "tool.sensitive",
              "tool.safe",
              "tool.classified",
              "tool.owner_arg",
              "identity",
              "fixtures.attacker",
              "fixtures.victim",
              "fixtures.victim.records",
              "canaries",
              "output_sink",
              "target.reset",
              "direct_tool_access",
              "entry_supported"
            ],
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "code"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ReportDiagnostic": {
      "additionalProperties": false,
      "description": "Something the report found while treating data. It never quotes the value.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "level": {
          "default": "warning",
          "enum": [
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ReportDiagnostic",
      "type": "object"
    },
    "Reproduction": {
      "additionalProperties": false,
      "description": "An argument list to run in ``cwd``, relative to the project root. Never run by Gazua.\n\nAn unavailable command keeps its reason and is not offered for copying.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "cwd": {
          "default": ".",
          "pattern": "^(\\.|[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*)$",
          "title": "Cwd",
          "type": "string"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "argv",
        "available"
      ],
      "title": "Reproduction",
      "type": "object"
    },
    "RunMetadata": {
      "additionalProperties": false,
      "description": "When and how the run happened. Nothing absent is invented.",
      "properties": {
        "created_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "title": "Created At",
          "type": "string"
        },
        "gazua_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gazua Version"
        },
        "target_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "mode": {
          "enum": [
